# ─────────────────────────────────────────────────────────────
#  SARL AK — Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Example (local):      postgresql://user:password@localhost:5432/sarl_ak
# Example (Supabase):   postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sarl_ak

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Admin credentials (used only on first startup to seed the admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Server port (optional, defaults to 3000)
PORT=3000

# Directory where uploaded files are stored (optional, defaults to ./uploads inside backend/)
# UPLOADS_DIR=/var/data/sarl-ak-uploads

# Node environment
NODE_ENV=production

# CORS allowed origin (optional; leave blank to allow all origins)
# CORS_ORIGIN=https://www.your-domain.com
